{
  "name": "@paperclipai/adapter-copilot-local",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/plugin.ts",
    "./server": "./src/server/index.ts",
    "./ui": "./src/ui/index.ts",
    "./cli": "./src/cli/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./dist/plugin.d.ts", "import": "./dist/plugin.js" },
      "./server": { "types": "./dist/server/index.d.ts", "import": "./dist/server/index.js" },
      "./ui": { "types": "./dist/ui/index.d.ts", "import": "./dist/ui/index.js" },
      "./cli": { "types": "./dist/cli/index.d.ts", "import": "./dist/cli/index.js" }
    }
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.15",
    "@paperclipai/adapter-utils": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.7.3"
  }
}
